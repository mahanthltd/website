# Copy to .env for local dev (gitignored).

# Resend API key — sends contact-form submissions. Without it the form
# returns a friendly error and logs server-side (see
# web/app/api/contact/route.ts); no SMTP fallback by design.
RESEND_API_KEY=

# Where contact-form submissions are sent. Defaults to support@mahanthltd.co.uk
# if unset.
CONTACT_TO_EMAIL=support@mahanthltd.co.uk
